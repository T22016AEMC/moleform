{
  "name": "moleform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/third-party-notices.mjs && npm run build --prefix packages/ketcher-frame",
    "preview": "vite preview",
    "test": "vitest run",
    "test:clean": "node -e \"for (const d of ['node_modules/.vitest-cache','node_modules/.vite/vitest']) require('fs').rmSync(d,{recursive:true,force:true})\" && vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix packages/ketcher-frame",
    "verify:phase2": "node scripts/verification/phase2.mjs",
    "verify:phase3": "node scripts/verification/phase3.ts",
    "verify:phase4": "node scripts/verification/phase4.ts",
    "verify:phase5": "node scripts/verification/phase5.ts",
    "verify:phase6-tg": "node scripts/verification/phase6-tg.ts",
    "verify:phase6-tbtf": "node scripts/verification/phase6-TbTf.ts",
    "verify:phase6-vw-tpsa-logp": "node scripts/verification/phase6-VW-TPSA-LogP.ts",
    "verify:phase6-vm": "node scripts/verification/phase6-Vm-密度.ts"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.9.1",
    "3dmol": "2.5.5",
    "openchemlib": "9.25.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
